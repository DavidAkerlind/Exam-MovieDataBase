{
    "name": "MMDb – My Movie Database",
    "short_name": "MMDb",
    "description": "Discover the best movies of all time, watch trailers and keep your favourites in one place.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "orientation": "portrait-primary",
    "background_color": "#05060d",
    "theme_color": "#05060d",
    "categories": ["entertainment", "movies"],
    "icons": [
        { "src": "res/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "res/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
        { "src": "res/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ]
}
